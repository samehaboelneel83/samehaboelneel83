# Hierarchical commitment planning.
#
# Not a timetable: units form a tree, commitments compete for limited time by
# weight, and a parent's availability constrains every unit beneath it. Written
# entirely in the problem language — there is no Python behind this file.
#
#   Organisation
#     ├── Operations          ├── Training
#     │     ├── Ops North     │     ├── Instruction
#     │     └── Ops South     │     └── Assessment
#
# Three things make it a planning model rather than a scheduler:
#   * a commitment may go unmet, at the cost of its weight;
#   * load is balanced across units by squeezing the gap between the busiest
#     and the idlest, not by minimising variance (which is not linear);
#   * specialties are a second, independent capacity dimension.

problem commitment_plan "Hierarchical commitment planning"
  "Allocate limited unit time to weighted commitments across an organisation tree."

# ---------------------------------------------------------------- structure

set Units = ops_north, ops_south, instruction, assessment of unit
  "The leaf units that actually spend time"

set Commitments = patrol, inspection, drill, course_a, course_b, review, audit of commitment

set Specialties = field, classroom of specialty

# Five working days of four periods, numbered across the week so a period
# knows which day it belongs to.
set Periods : int = 0..19 labels {
    0: "Mon 1", 1: "Mon 2", 2: "Mon 3", 3: "Mon 4",
    4: "Tue 1", 5: "Tue 2", 6: "Tue 3", 7: "Tue 4",
    8: "Wed 1", 9: "Wed 2", 10: "Wed 3", 11: "Wed 4",
    12: "Thu 1", 13: "Thu 2", 14: "Thu 3", 15: "Thu 4",
    16: "Fri 1", 17: "Fri 2", 18: "Fri 3", 19: "Fri 4" }

set Days : int = 0..4 labels {
    0: "Mon", 1: "Tue", 2: "Wed", 3: "Thu", 4: "Fri" }

param day_of[Periods] "Which day a period falls in" = {
    0: 0, 1: 0, 2: 0, 3: 0, 4: 1, 5: 1, 6: 1, 7: 1,
    8: 2, 9: 2, 10: 2, 11: 2, 12: 3, 13: 3, 14: 3, 15: 3,
    16: 4, 17: 4, 18: 4, 19: 4 }

# ------------------------------------------------------------- commitments

param weight[Commitments] "What fulfilling it is worth" = {
    patrol: 100, inspection: 80, drill: 60,
    course_a: 90, course_b: 40, review: 30, audit: 20 }

param mandatory[Commitments] default 0 "1 when it cannot be dropped" = {
    patrol: 1, inspection: 1, course_a: 1 }

param sessions[Commitments] "Periods it needs each week" = {
    patrol: 4, inspection: 2, drill: 2,
    course_a: 3, course_b: 2, review: 1, audit: 1 }

# Which unit may carry which commitment, and which specialty it consumes.
param assigned[Commitments, Units] default 0 "1 when the unit may take it" = {
    (patrol, ops_north): 1, (patrol, ops_south): 1,
    (inspection, ops_north): 1, (inspection, ops_south): 1,
    (drill, ops_north): 1, (drill, ops_south): 1,
    (course_a, instruction): 1, (course_b, instruction): 1,
    (review, assessment): 1, (audit, assessment): 1 }

param needs[Commitments, Specialties] default 0 "Specialty the commitment consumes" = {
    (patrol, field): 1, (inspection, field): 1, (drill, field): 1,
    (course_a, classroom): 1, (course_b, classroom): 1,
    (review, classroom): 1, (audit, classroom): 1 }

# ------------------------------------------------------- availability

# A unit is available only where its parents are. The parent's reserved time
# has already been folded in here, which is what "ChildPlan subset of
# ParentPlan" means once it reaches the solver.
param available[Units, Periods] default 1 "1 when the unit may be committed" = {
    (ops_north, 0): 0, (ops_north, 1): 0,
    (ops_south, 0): 0, (ops_south, 1): 0,
    (instruction, 16): 0, (instruction, 17): 0,
    (instruction, 18): 0, (instruction, 19): 0,
    (assessment, 16): 0, (assessment, 17): 0,
    (assessment, 18): 0, (assessment, 19): 0 }

# Deliberately tight: there is not enough time for everything, which is the
# whole point — the plan has to choose, and weight is how it chooses.
param capacity[Units] "Periods a unit can spend in a week" = {
    ops_north: 6, ops_south: 4, instruction: 4, assessment: 1 }

param specialty_capacity[Specialties] = { field: 2, classroom: 2 }
  "Commitments of one specialty that can run at the same moment"

param max_daily[Units] = { ops_north: 3, ops_south: 3, instruction: 3, assessment: 3 }
  "Most periods a unit spends in one day"

# ------------------------------------------------------------- decisions

var allocate[Commitments, Units, Periods] binary
  means "Spend this unit's period on this commitment"

var met[Commitments] binary
  means "Deliver this commitment in full"

# Busiest and idlest load, so the spread between units can be squeezed without
# a variance term, which would not be linear.
var busiest continuous in [0, 20] "Periods spent by the most loaded unit"
var idlest continuous in [0, 20] "Periods spent by the least loaded unit"

# ----------------------------------------------------------- hard rules

constraint deliver_in_full "A commitment is either given all its periods or none"
  category operational
  because "Half a course is not a course; partial delivery is not fulfilment"
  forall c in Commitments:
    sum(allocate[c, u, p] for u in Units, p in Periods) == sessions[c] * met[c]

constraint mandatory_commitments_are_met "Mandatory commitments cannot be dropped"
  category regulatory
  forall c in Commitments where mandatory[c] == 1:
    met[c] >= 1

constraint only_assigned_units "Only a unit the commitment is assigned to may carry it"
  category policy
  sum(allocate[c, u, p] for c in Commitments, u in Units, p in Periods
      where assigned[c, u] == 0) == 0

constraint respect_availability "Nothing is committed when the unit is unavailable"
  category physical
  because "A parent's reserved time has already been folded into this table, so "
          "blocking the parent blocks every unit beneath it"
  sum(allocate[c, u, p] for c in Commitments, u in Units, p in Periods
      where available[u, p] == 0) == 0

constraint one_thing_at_a_time "A unit does one thing in a period"
  category physical
  forall u in Units, p in Periods:
    sum(allocate[c, u, p] for c in Commitments) <= 1

constraint unit_capacity "A unit does not exceed its weekly capacity"
  category physical
  forall u in Units:
    sum(allocate[c, u, p] for c in Commitments, p in Periods) <= capacity[u]

constraint daily_limit "A unit does not exceed its daily limit"
  category policy
  forall u in Units, d in Days:
    sum(allocate[c, u, p] for c in Commitments, p in Periods
        where day_of[p] == d) <= max_daily[u]

constraint specialty_capacity_holds "A specialty is not oversubscribed in a period"
  category physical
  because "Specialties are a capacity dimension of their own, cutting across the unit tree"
  forall s in Specialties, p in Periods:
    sum(allocate[c, u, p] for c in Commitments, u in Units
        where needs[c, s] == 1) <= specialty_capacity[s]

constraint busiest_covers_every_unit "The busiest load is at least every unit's load"
  category modelling
  forall u in Units:
    busiest >= sum(allocate[c, u, p] for c in Commitments, p in Periods)

constraint idlest_under_every_unit "The idlest load is at most every unit's load"
  category modelling
  forall u in Units:
    idlest <= sum(allocate[c, u, p] for c in Commitments, p in Periods)

# ------------------------------------------------------------ objectives

maximize commitment_coverage "Deliver as much weighted commitment as possible"
  unit "weight points" weight 10:
  sum(weight[c] * met[c] for c in Commitments)

minimize load_spread "Keep the units evenly loaded" unit "periods" weight 1:
  busiest - idlest

# ----------------------------------------------------------- assumptions

assume commitments_are_all_or_nothing "A commitment is delivered in full or not at all"
  because "Partial delivery is modelled as failure, so coverage means what it says"
  affects deliver_in_full, commitment_coverage

assume parent_time_folded_into_children "A parent's reserved time is already reflected "
                                        "in each child's availability"
  because "Intersecting the tree once, before solving, is cheaper than carrying the "
          "hierarchy into every constraint — and gives the same answer"
  affects respect_availability

assume balance_is_a_range_not_a_variance "Balance is the gap between the busiest and "
                                         "idlest unit"
  because "Variance is quadratic and this model is linear; the range is the linear "
          "measure of the same idea"
  affects load_spread

assume sessions_are_interchangeable "The periods of one commitment are interchangeable"
  because "No ordering or spacing between a commitment's own sessions is modelled"
  affects deliver_in_full

assume weights_are_comparable "Weights across commitments are on one scale"
  because "Coverage sums them, so a weight of 100 is worth five of 20"
  affects commitment_coverage

# ------------------------------------------------------------- scenarios

scenario surge "Operations capacity cut by a fifth"
  "A competing tasking takes a fifth of both operations units. A unit cannot "
  "spend a fraction of a period, so usable capacity falls further than the "
  "stated cut, and a deeper cut makes the mandatory commitments impossible "
  "rather than merely expensive."
  scale capacity[ops_north] by 0.8
  scale capacity[ops_south] by 0.8

scenario invest "One more period for instruction and assessment"
  "The planning question in reverse: what would it take to cover everything?"
  set capacity[instruction] to 6
  set capacity[assessment] to 2

scenario tighter_days "At most two periods a day"
  scale max_daily by 0.66

scenario scarce_classrooms "One classroom commitment at a time"
  set specialty_capacity[classroom] to 1
