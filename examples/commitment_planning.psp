# Hierarchical commitment planning.
#
# Three independent hierarchies meet in one model, and the same rule is written
# once for each, because a level in every case is only a set of things that
# roll up.
#
#   UNIT TREE                SPECIALTY TREE          TIME TREE
#   organisation             capability              horizon
#     operations               field                   week_1
#       ops_north                mounted                 w1_mon ...
#       ops_south                dismounted            week_2
#     training                 classroom                 w2_mon ...
#       instruction              teaching
#       assessment               examining
#
# A commitment may be assigned at ANY level of the unit tree, and a commitment
# on a branch engages everything beneath it: when operations runs a joint
# exercise, both its units are in it and neither can be doing anything else.
# Time is therefore counted in unit-periods at the leaves, so a branch
# commitment costs one period from each unit it engages, and a parent's load is
# genuinely its children's added together.
#
# Written entirely in the problem language. There is no Python behind this file.

problem commitment_plan "Hierarchical commitment planning"
  "Allocate limited time to weighted commitments assigned at any level of an "
  "organisation, respecting capacity across the unit, specialty and time trees."

# ---------------------------------------------------------------- the trees

set Units = organisation, operations, training, ops_north, ops_south, instruction, assessment of unit
  "Every node of the unit tree. A commitment may be assigned to any of them"

set Commitments = all_hands, joint_exercise, patrol, inspection, drill,
                  course_a, course_b, review, audit of commitment

set Specialties = capability, field, classroom, mounted, dismounted, teaching, examining of specialty

set TimeNodes = horizon, week_1, w1_mon, w1_tue, w1_wed, w1_thu, w1_fri, week_2, w2_mon, w2_tue, w2_wed, w2_thu, w2_fri of planning_period
  "Every node of the period tree: the horizon, its weeks, and their days"

set Periods : int = 0..19 labels {
    0: "W1 Mon AM",
    1: "W1 Mon PM",
    2: "W1 Tue AM",
    3: "W1 Tue PM",
    4: "W1 Wed AM",
    5: "W1 Wed PM",
    6: "W1 Thu AM",
    7: "W1 Thu PM",
    8: "W1 Fri AM",
    9: "W1 Fri PM",
    10: "W2 Mon AM",
    11: "W2 Mon PM",
    12: "W2 Tue AM",
    13: "W2 Tue PM",
    14: "W2 Wed AM",
    15: "W2 Wed PM",
    16: "W2 Thu AM",
    17: "W2 Thu PM",
    18: "W2 Fri AM",
    19: "W2 Fri PM" }

# Ancestor-or-self over each tree: 1 when the first node covers the second.
# This one relation is what lets a parent's capacity constrain everything
# beneath it, and it is the only thing the three hierarchies have in common.
param unit_covers[Units, Units] default 0 = {
    (organisation, organisation): 1, (operations, operations): 1, (training, training): 1,
    (ops_north, ops_north): 1, (ops_south, ops_south): 1, (instruction, instruction): 1,
    (assessment, assessment): 1, (organisation, operations): 1, (organisation, training): 1,
    (operations, ops_north): 1, (organisation, ops_north): 1, (operations, ops_south): 1,
    (organisation, ops_south): 1, (training, instruction): 1, (organisation, instruction): 1,
    (training, assessment): 1, (organisation, assessment): 1 }

param specialty_covers[Specialties, Specialties] default 0 = {
    (capability, capability): 1, (field, field): 1, (classroom, classroom): 1,
    (mounted, mounted): 1, (dismounted, dismounted): 1, (teaching, teaching): 1,
    (examining, examining): 1, (capability, field): 1, (capability, classroom): 1,
    (field, mounted): 1, (capability, mounted): 1, (field, dismounted): 1,
    (capability, dismounted): 1, (classroom, teaching): 1, (capability, teaching): 1,
    (classroom, examining): 1, (capability, examining): 1 }

param is_leaf[Units] default 0 "1 for a unit with nothing beneath it" = {
    ops_north: 1, ops_south: 1, instruction: 1, assessment: 1 }

# How many leaf units two nodes of the tree have in common. This is what lets a
# branch commitment cost the right amount: assigning one to operations engages
# both its units, so it consumes two unit-periods, and it shows up in the load
# of every node that shares a unit with it.
#
# It is derivable from unit_covers and is_leaf, and the rules below could count
# the shared leaves themselves. Stating it as a table instead keeps a term for
# each pair of units rather than one for each pair and every leaf between them,
# which is the difference between a model that flattens in seconds and one that
# does not on a real organisation. Same model either way; only the cost of
# building it differs.
param unit_overlap[Units, Units] default 0 = {
    (organisation, organisation): 4, (organisation, operations): 2, (organisation, training): 2, (organisation, ops_north): 1,
    (organisation, ops_south): 1, (organisation, instruction): 1, (organisation, assessment): 1, (operations, organisation): 2,
    (operations, operations): 2, (operations, ops_north): 1, (operations, ops_south): 1, (training, organisation): 2,
    (training, training): 2, (training, instruction): 1, (training, assessment): 1, (ops_north, organisation): 1,
    (ops_north, operations): 1, (ops_north, ops_north): 1, (ops_south, organisation): 1, (ops_south, operations): 1,
    (ops_south, ops_south): 1, (instruction, organisation): 1, (instruction, training): 1, (instruction, instruction): 1,
    (assessment, organisation): 1, (assessment, training): 1, (assessment, assessment): 1 }

# A node of the time tree is a contiguous range of periods. That is the whole
# of what a level is, so one rule governs a day, a week and the horizon alike.
param first_period[TimeNodes] = {
    horizon: 0, week_1: 0, w1_mon: 0, w1_tue: 2, w1_wed: 4,
    w1_thu: 6, w1_fri: 8, week_2: 10, w2_mon: 10, w2_tue: 12,
    w2_wed: 14, w2_thu: 16, w2_fri: 18 }
param last_period[TimeNodes] = {
    horizon: 19, week_1: 9, w1_mon: 1, w1_tue: 3, w1_wed: 5,
    w1_thu: 7, w1_fri: 9, week_2: 19, w2_mon: 11, w2_tue: 13,
    w2_wed: 15, w2_thu: 17, w2_fri: 19 }
param node_depth[TimeNodes] default 0 "Depth in the period tree" = {
    horizon: 0, week_1: 1, w1_mon: 2, w1_tue: 2, w1_wed: 2,
    w1_thu: 2, w1_fri: 2, week_2: 1, w2_mon: 2, w2_tue: 2,
    w2_wed: 2, w2_thu: 2, w2_fri: 2 }

# ------------------------------------------------------------- commitments

param weight[Commitments] "What fulfilling it is worth" = {
    all_hands: 50, joint_exercise: 85, patrol: 100, inspection: 80, drill: 60,
    course_a: 90, course_b: 40, review: 30, audit: 20 }

param mandatory[Commitments] default 0 "1 when it cannot be dropped" = {
    all_hands: 1, patrol: 1, inspection: 1, course_a: 1 }

param sessions[Commitments] "Periods of calendar time it needs" = {
    all_hands: 1, joint_exercise: 2, patrol: 6, inspection: 4, drill: 2,
    course_a: 4, course_b: 2, review: 2, audit: 2 }

# Assignment at any level: all_hands belongs to the organisation, the joint
# exercise to the operations branch, the rest to individual units.
param assigned[Commitments, Units] default 0 "1 when the unit may take it" = {
    (all_hands, organisation): 1,
    (joint_exercise, operations): 1,
    (patrol, ops_north): 1, (patrol, ops_south): 1,
    (inspection, ops_north): 1, (inspection, ops_south): 1,
    (drill, ops_north): 1, (drill, ops_south): 1,
    (course_a, instruction): 1, (course_b, instruction): 1,
    (review, assessment): 1, (audit, assessment): 1 }

# A commitment may draw on an interior capability as readily as on a craft.
param needs[Commitments, Specialties] default 0 = {
    (all_hands, capability): 1, (joint_exercise, field): 1,
    (patrol, mounted): 1, (inspection, dismounted): 1, (drill, dismounted): 1,
    (course_a, teaching): 1, (course_b, teaching): 1,
    (review, examining): 1, (audit, examining): 1 }

param required_in[Commitments, TimeNodes] default 0
  "Frequency is a rollup, not a total: three patrols a week, not six whenever" = {
    (patrol, week_1): 3, (patrol, week_2): 3,
    (inspection, week_1): 2, (inspection, week_2): 2,
    (course_a, week_1): 2, (course_a, week_2): 2,
    (course_a, w1_mon): 2 }

# ------------------------------------------------------------ availability

param available[Units, Periods] default 1 "1 when the unit may be committed" = {
    (operations, 0): 0, (operations, 1): 0,
    (assessment, 18): 0, (assessment, 19): 0 }

# Allowance at every node of both the unit tree and the time tree, in
# unit-periods — so a branch's allowance is directly comparable with the sum of
# its children's, and a branch that cannot afford them constrains them.
param allowance[Units, TimeNodes] default 999
  "Unit-periods this part of the organisation may spend under a node" = {
    (organisation, horizon): 26,
    (operations, horizon): 18, (training, horizon): 8,
    (ops_north, horizon): 10, (ops_south, horizon): 10,
    (instruction, horizon): 6, (assessment, horizon): 4,
    (organisation, week_1): 14, (organisation, week_2): 14,
    (operations, week_1): 11, (operations, week_2): 11,
    (training, week_1): 6, (training, week_2): 6 }

param daily_allowance[Units] default 2 "Unit-periods a leaf spends in one day" = {
    ops_north: 2, ops_south: 2, instruction: 2, assessment: 2 }

param specialty_capacity[Specialties] "Commitments of this capability at one moment" = {
    capability: 2, field: 2, classroom: 2,
    mounted: 1, dismounted: 1, teaching: 1, examining: 1 }

# --------------------------------------------------------------- decisions

var allocate[Commitments, Units, Periods] binary
  means "Run this commitment at this level of the organisation, in this period"

var met[Commitments] binary
  means "Deliver this commitment in full"

var load[Units, TimeNodes] continuous in [0, 999]
  means "Unit-periods this part of the organisation spends in this part of the horizon"

var busiest continuous in [0, 999] "Unit-periods spent by the most loaded unit"
var idlest continuous in [0, 999] "Unit-periods spent by the least loaded unit"

# -------------------------------------------------------------- hard rules

constraint rollup "Load under a node is the unit-periods spent there, counting a "
                  "branch commitment against every unit it engages"
  category modelling
  because "A commitment on a branch occupies each unit beneath it, so it costs "
          "one period from each — which is what makes a parent's load equal to "
          "its children's added together"
  forall u in Units, n in TimeNodes:
    load[u, n] == sum(unit_overlap[u, u2] * allocate[c, u2, p]
                      for c in Commitments, u2 in Units, p in Periods
                      where unit_overlap[u, u2] > 0
                        and p >= first_period[n] and p <= last_period[n])

constraint one_thing_at_a_time "A unit does one thing in a period, whether the "
                               "commitment is its own or one it inherits from above"
  category physical
  because "A joint exercise at the branch leaves no room for a unit beneath it to "
          "be doing something else"
  forall u in Units, p in Periods where is_leaf[u] == 1:
    sum(allocate[c, u2, p] for c in Commitments, u2 in Units
        where unit_covers[u2, u] == 1) <= 1

constraint allowance_at_every_level "No part of the organisation exceeds its "
                                    "allowance at any level of the horizon"
  category physical
  because "A parent that cannot afford the sum of its children constrains them, "
          "even where each child would fit on its own"
  forall u in Units, n in TimeNodes:
    load[u, n] <= allowance[u, n]

constraint daily_limit "No unit exceeds its daily limit"
  category policy
  forall u in Units, n in TimeNodes where is_leaf[u] == 1 and node_depth[n] == 2:
    load[u, n] <= daily_allowance[u]

constraint deliver_in_full "A commitment is either given all its periods or none"
  category operational
  because "Half a course is not a course; partial delivery is not fulfilment"
  forall c in Commitments:
    sum(allocate[c, u, p] for u in Units, p in Periods) == sessions[c] * met[c]

constraint frequency_within_each_node "A commitment with a stated frequency meets it "
                                      "inside every node it applies to"
  category operational
  forall c in Commitments, n in TimeNodes where required_in[c, n] > 0:
    sum(allocate[c, u, p] for u in Units, p in Periods
        where p >= first_period[n] and p <= last_period[n])
      == required_in[c, n] * met[c]

constraint mandatory_commitments_are_met "Mandatory commitments cannot be dropped"
  category regulatory
  forall c in Commitments where mandatory[c] == 1:
    met[c] >= 1

constraint only_assigned_units "A commitment runs only at a level it is assigned to"
  category policy
  because "The level a commitment is booked at is a decision about who owns it, "
          "not a decision the plan is free to make"
  sum(allocate[c, u, p] for c in Commitments, u in Units, p in Periods
      where assigned[c, u] == 0) == 0

constraint respect_availability "Nothing runs when any unit it engages is unavailable"
  category physical
  because "A commitment at a branch needs every unit beneath it, and a unit is also "
          "stopped by anything reserved above it — so the block travels both ways "
          "along the path"
  sum(allocate[c, u, p] for c in Commitments, u in Units, p in Periods, a in Units
      where unit_overlap[a, u] > 0 and available[a, p] == 0) == 0

constraint specialty_capacity_at_every_level "A capability is not oversubscribed at "
                                             "any level of the specialty tree"
  category physical
  because "A parent capability's capacity constrains everything beneath it, so the "
          "crafts cannot each fit and together overrun"
  forall s in Specialties, p in Periods:
    sum(allocate[c, u, p] for c in Commitments, u in Units, s2 in Specialties
        where specialty_covers[s, s2] == 1 and needs[c, s2] == 1)
      <= specialty_capacity[s]

constraint busiest_covers_every_unit "The busiest load is at least every leaf unit's load"
  category modelling
  forall u in Units where is_leaf[u] == 1:
    busiest >= load[u, horizon]

constraint idlest_under_every_unit "The idlest load is at most every leaf unit's load"
  category modelling
  forall u in Units where is_leaf[u] == 1:
    idlest <= load[u, horizon]

# -------------------------------------------------------------- objectives

maximize commitment_coverage "Deliver as much weighted commitment as possible"
  unit "weight points"
  weight 10:
  sum(weight[c] * met[c] for c in Commitments)

minimize load_spread "Keep the units evenly loaded" unit "unit-periods" weight 1:
  busiest - idlest

# ------------------------------------------------------------- assumptions

assume commitments_are_all_or_nothing "A commitment is delivered in full or not at all"
  because "Partial delivery is modelled as failure, so coverage means what it says"
  affects deliver_in_full, commitment_coverage

assume a_branch_commitment_engages_everything_beneath_it "A commitment assigned to a "
                                                         "branch occupies every unit "
                                                         "under it"
  because "A joint exercise is not a thing the branch does instead of its units; it "
          "is a thing they all do together, so it costs each of them the period"
  affects rollup, one_thing_at_a_time, respect_availability

assume time_is_counted_in_unit_periods "Load is measured in unit-periods, so one "
                                       "period of a two-unit branch costs two"
  because "It is the only measure in which a parent's load equals its children's "
          "added together, whatever level the commitments were assigned at"
  affects rollup, allowance_at_every_level

assume a_level_is_a_set_that_rolls_up "A level of any of the three trees is a set of "
                                      "things that aggregate into it"
  because "That is what lets one rule govern a craft and a capability, a day and a "
          "horizon, a section and a department, instead of one rule per level"
  affects rollup, allowance_at_every_level, specialty_capacity_at_every_level

assume balance_is_a_range_not_a_variance "Balance is the gap between the busiest and "
                                         "idlest leaf unit over the horizon"
  because "Variance is quadratic and this model is linear; the range is the linear "
          "measure of the same idea"
  affects load_spread

assume weights_are_comparable "Weights across commitments are on one scale"
  because "Coverage sums them, so a weight of 100 is worth five of 20"
  affects commitment_coverage

# --------------------------------------------------------------- scenarios

scenario surge "Operations cut by a sixth"
  "A competing tasking takes a sixth of the operations branch. The cut is made "
  "once, at the branch, and reaches both units beneath it through the tree."
  scale allowance[operations, horizon] by 0.85
  scale allowance[operations, week_1] by 0.85
  scale allowance[operations, week_2] by 0.85

scenario invest "More room across the organisation"
  "The planning question in reverse: what would it take to cover everything?"
  set allowance[organisation, horizon] to 34
  set allowance[organisation, week_1] to 20
  set allowance[organisation, week_2] to 20
  set allowance[training, horizon] to 14
  set allowance[training, week_1] to 8
  set allowance[training, week_2] to 8
  set allowance[instruction, horizon] to 8
  set allowance[assessment, horizon] to 6

scenario assessment_stood_down "The smallest unit is away for a week"
  "One leaf unit is unavailable for the whole of week 1. It pushes the "
  "organisation's own commitment into week 2, because a commitment booked "
  "above a unit still needs that unit in the room — which is how availability "
  "travels up the tree as well as down it."
  set available[assessment, 0] to 0
  set available[assessment, 1] to 0
  set available[assessment, 2] to 0
  set available[assessment, 3] to 0
  set available[assessment, 4] to 0
  set available[assessment, 5] to 0
  set available[assessment, 6] to 0
  set available[assessment, 7] to 0
  set available[assessment, 8] to 0
  set available[assessment, 9] to 0

scenario serialised_organisation "One commitment anywhere at a time"
  "The capability at the root of the specialty tree is cut to one, so nothing runs "
  "in parallel anywhere. The crafts beneath it are untouched and still fit "
  "individually, so a model without the tree would see no constraint at all."
  set specialty_capacity[capability] to 1
