# Copy to backend/.env to change how the API runs. Every value has a working
# default, so an empty file is a valid configuration.

# Storage. Omit for SQLite on disk, which needs no external service.
# PSP_DATABASE_URL=postgresql+psycopg://psp:psp@localhost:5432/psp

# Authentication. With no issuer set the API runs open and says so at
# /api/health. Set both of these before exposing it to anyone.
# PSP_AUTH_REQUIRED=true
# PSP_KEYCLOAK_ISSUER=http://localhost:8080/realms/psp
# PSP_KEYCLOAK_AUDIENCE=psp-api

# Solve limits. The second is a hard ceiling on what a caller may request.
# PSP_SOLVE_TIME_LIMIT_SECONDS=30
# PSP_SOLVE_MAX_TIME_LIMIT_SECONDS=600
